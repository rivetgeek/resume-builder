<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ name }} - {{ title }}</title>
  <style>
    @page {
      margin: 0.75in;
    }
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11pt;
      margin: 0;
      padding: 0;
      color: #2c3e50;
      background: #fff;
      line-height: 1.6;
    }
    .container {
      width: 100%;
      max-width: 8.5in;
    }
    h1 {
      font-size: 28pt;
      font-weight: 700;
      margin-bottom: 0.2em;
      color: #1a1a1a;
      letter-spacing: -0.5px;
    }
    h2 {
      font-size: 14pt;
      font-weight: 700;
      color: #1a1a1a;
      margin-top: 1.5em;
      margin-bottom: 0.5em;
      text-transform: uppercase;
      letter-spacing: 1px;
      border-bottom: 2px solid #1a1a1a;
      padding-bottom: 0.3em;
    }
    h3 {
      font-size: 12pt;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 0.2em;
      margin-top: 0.5em;
    }
    .subtitle {
      font-size: 12pt;
      font-weight: 400;
      color: #555;
      margin-bottom: 1em;
    }
    .contact-bar {
      font-size: 9pt;
      color: #666;
      margin-bottom: 1.5em;
      line-height: 1.8;
    }
    .contact-item {
      display: block;
      margin-bottom: 0.2em;
    }
    .contact-item::before {
      content: "→ ";
      color: #999;
      font-weight: 300;
    }
    .section {
      margin-bottom: 1.2em;
    }
    .section p {
      margin: 0.5em 0;
      text-align: justify;
    }
    .job-block {
      margin-bottom: 1.2em;
      page-break-inside: avoid;
    }
    .job-header {
      margin-bottom: 0.5em;
    }
    .job-title {
      font-size: 12pt;
      font-weight: 700;
      color: #1a1a1a;
      display: inline;
    }
    .job-company {
      font-size: 12pt;
      font-weight: 400;
      color: #555;
      display: inline;
    }
    .job-company::before {
      content: " • ";
      color: #999;
    }
    .job-dates {
      font-size: 10pt;
      font-style: italic;
      color: #777;
      margin-top: 0.2em;
    }
    ul {
      list-style-type: disc;
      padding-left: 1.5em;
      margin: 0.5em 0;
    }
    li {
      margin-bottom: 0.4em;
      line-height: 1.5;
    }
    .columns-2 {
      display: flex;
      gap: 2em;
      margin-top: 0.5em;
    }
    .columns-2 .column {
      width: 50%;
    }
    .columns-2 .column p {
      margin: 0.3em 0;
      font-size: 10pt;
    }
    .tech-section {
      display: flex;
      gap: 2em;
      margin-top: 0.5em;
    }
    .tech-column {
      width: 50%;
    }
    .tech-column p {
      margin: 0.3em 0;
      font-size: 10pt;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>{{ name }}</h1>
    <div class="subtitle">{{ title }}</div>
    
    {% if contact %}
    <div class="contact-bar">
      {% if contact.email %}<div class="contact-item">{{ contact.email }}</div>{% endif %}
      {% if contact.mobile %}<div class="contact-item">{{ contact.mobile }}</div>{% endif %}
      {% if contact.location %}<div class="contact-item">{{ contact.location }}</div>{% endif %}
    </div>
    {% endif %}
    
    {% if summary %}
    <div class="section">
      <h2>Summary</h2>
      <p>{{ summary }}</p>
    </div>
    {% endif %}
    
    {% if highlights %}
    <div class="section">
      <h2>Highlights</h2>
      {% set clean_highlights = highlights | map('string') | reject('equalto', '') | list %}
      {% if clean_highlights %}
      <ul>
        {% for item in clean_highlights %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endif %}
    
    {% if experience %}
    <div class="section">
      <h2>Professional Experience</h2>
      {% for job in experience %}
        <div class="job-block">
          <div class="job-header">
            <span class="job-title">{{ job.title }}</span>
            <span class="job-company">{{ job.company }}</span>
          </div>
          <div class="job-dates">{{ job.dates }}</div>
          {% set clean_bullets = job.bullets | map('string') | reject('equalto', '') | list %}
          {% if clean_bullets %}
          <ul>
            {% for bullet in clean_bullets %}
              <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% endif %}
    
    {% if General_Technologies or Security_Tools %}
    <div class="section">
      <h2>Technical Skills</h2>
      <div class="tech-section">
        {% if General_Technologies %}
        <div class="tech-column">
          <h3>General Technologies</h3>
          {% for item in General_Technologies %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
        {% endif %}
        {% if Security_Tools %}
        <div class="tech-column">
          <h3>Security Tools</h3>
          {% for item in Security_Tools %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}
    
    {% if Security_Disciplines %}
    <div class="section">
      <h2>Security Disciplines</h2>
      <div class="columns-2">
        <div class="column">
          {% for item in Security_Disciplines[0::2] %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
        <div class="column">
          {% for item in Security_Disciplines[1::2] %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    
    {% if Languages %}
    <div class="section">
      <h2>Programming Languages</h2>
      <div class="columns-2">
        <div class="column">
          {% for item in Languages[0::2] %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
        <div class="column">
          {% for item in Languages[1::2] %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    
    {% if objective %}
    <div class="section">
      <h2>Objective</h2>
      <p>{{ objective }}</p>
    </div>
    {% endif %}
  </div>
</body>
</html>

