<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ name }} - {{ title }}</title>
  <style>
    @page {
      margin: 1in;
    }
    body {
      font-family: "Times New Roman", Times, serif;
      font-size: 11pt;
      margin: 0;
      padding: 0;
      color: #000;
      background: #fff;
      line-height: 1.5;
    }
    .container {
      width: 100%;
    }
    h1 {
      font-size: 24pt;
      font-weight: 700;
      margin-bottom: 0.1em;
      color: #000;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    h2 {
      font-size: 14pt;
      font-weight: 700;
      color: #000;
      margin-top: 1.2em;
      margin-bottom: 0.5em;
      text-transform: uppercase;
      letter-spacing: 1px;
      border-bottom: 1px solid #000;
      padding-bottom: 0.2em;
    }
    h3 {
      font-size: 11pt;
      font-weight: 700;
      color: #000;
      margin-bottom: 0.2em;
      margin-top: 0.5em;
    }
    .subtitle {
      font-size: 11pt;
      font-weight: 400;
      color: #000;
      margin-bottom: 0.5em;
      text-align: center;
      font-style: italic;
    }
    .contact-bar {
      text-align: center;
      font-size: 10pt;
      color: #000;
      margin-bottom: 1em;
      padding-bottom: 0.5em;
      border-bottom: 1px solid #000;
    }
    .contact-item {
      margin: 0 0.5em;
    }
    .contact-item::after {
      content: " | ";
      color: #000;
    }
    .contact-item:last-child::after {
      content: "";
    }
    .section {
      margin-bottom: 1em;
    }
    .section p {
      margin: 0.5em 0;
      text-align: left;
    }
    .job-block {
      margin-bottom: 1em;
      page-break-inside: avoid;
    }
    .job-title {
      font-size: 11pt;
      font-weight: 700;
      color: #000;
      margin-bottom: 0.2em;
    }
    .job-company {
      font-size: 11pt;
      font-weight: 400;
      color: #000;
      font-style: italic;
      margin-bottom: 0.2em;
    }
    .job-dates {
      font-size: 10pt;
      font-style: italic;
      color: #000;
      margin-bottom: 0.5em;
    }
    ul {
      list-style-type: none;
      padding-left: 0;
      margin: 0.5em 0;
    }
    li {
      margin-bottom: 0.3em;
      line-height: 1.4;
    }
    .columns-2 {
      display: flex;
      gap: 2em;
      margin-top: 0.5em;
    }
    .columns-2 .column {
      width: 50%;
    }
    .columns-2 .column p {
      margin: 0.3em 0;
      font-size: 10pt;
    }
    .tech-section {
      display: flex;
      gap: 2em;
      margin-top: 0.5em;
    }
    .tech-column {
      width: 50%;
    }
    .tech-column p {
      margin: 0.3em 0;
      font-size: 10pt;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>{{ name }}</h1>
    <div class="subtitle">{{ title }}</div>
    
    {% if contact %}
    <div class="contact-bar">
      {% if contact.email %}<span class="contact-item">{{ contact.email }}</span>{% endif %}
      {% if contact.mobile %}<span class="contact-item">{{ contact.mobile }}</span>{% endif %}
      {% if contact.location %}<span class="contact-item">{{ contact.location }}</span>{% endif %}
    </div>
    {% endif %}
    
    {% if summary %}
    <div class="section">
      <h2>Summary</h2>
      <p>{{ summary }}</p>
    </div>
    {% endif %}
    
    {% if highlights %}
    <div class="section">
      <h2>Highlights</h2>
      {% set clean_highlights = highlights | map('string') | reject('equalto', '') | list %}
      {% if clean_highlights %}<ul>{% for item in clean_highlights %}<li>• {{ item }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {% endif %}
    
    {% if experience %}
    <div class="section">
      <h2>Professional Experience</h2>
      {% for job in experience %}
        <div class="job-block">
          <div class="job-title">{{ job.title }}</div>
          <div class="job-company">{{ job.company }}</div>
          <div class="job-dates">{{ job.dates }}</div>
          {% set clean_bullets = job.bullets | map('string') | reject('equalto', '') | list %}
          {% if clean_bullets %}<ul>{% for bullet in clean_bullets %}<li>• {{ bullet }}</li>{% endfor %}</ul>{% endif %}
        </div>
      {% endfor %}
    </div>
    {% endif %}
    
    {% if General_Technologies or Security_Tools %}
    <div class="section">
      <h2>Technical Skills</h2>
      <div class="tech-section">
        {% if General_Technologies %}
        <div class="tech-column">
          <h3>General Technologies</h3>
          {% for item in General_Technologies %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
        {% endif %}
        {% if Security_Tools %}
        <div class="tech-column">
          <h3>Security Tools</h3>
          {% for item in Security_Tools %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}
    
    {% if Security_Disciplines %}
    <div class="section">
      <h2>Security Disciplines</h2>
      <div class="columns-2">
        <div class="column">
          {% for item in Security_Disciplines[0::2] %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
        <div class="column">
          {% for item in Security_Disciplines[1::2] %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    
    {% if Languages %}
    <div class="section">
      <h2>Programming Languages</h2>
      <div class="columns-2">
        <div class="column">
          {% for item in Languages[0::2] %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
        <div class="column">
          {% for item in Languages[1::2] %}
            <p>{{ item }}</p>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    
    {% if objective %}
    <div class="section">
      <h2>Objective</h2>
      <p>{{ objective }}</p>
    </div>
    {% endif %}
  </div>
</body>
</html>

