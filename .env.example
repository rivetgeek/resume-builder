# Copy to .env and fill before docker compose up or local Uvicorn.
#
# --- Password (Argon2) ---
# Generate:
#   python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
# Paste the ENTIRE printed string on ONE line. Do not add an opening " unless you close it —
# a broken quote breaks the whole file. Unquoted is fine ($ is not expanded; API uses interpolate=False).
#
# Good:
#   RESUME_BUILDER_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$salt$tag
# Bad (unclosed double quote):
#   RESUME_BUILDER_PASSWORD_HASH="$argon2id$v=19...
#
RESUME_BUILDER_PASSWORD_HASH=

# --- Session signing (>= 32 chars) ---
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RESUME_BUILDER_SESSION_SECRET=

# --- Local dev (http://localhost:3000) — REQUIRED for login over HTTP ---
# If these are missing, browsers will not send the Secure session cookie and login will fail.
RESUME_BUILDER_COOKIE_SECURE=0
RESUME_BUILDER_SKIP_ORIGIN_CHECK=1

# NEVER in production: skip session checks on protected API routes and relax mutating-request CSRF checks.
# Set in repo-root .env only for local troubleshooting; restart API and `npm run dev` after changing.
# RESUME_BUILDER_DEV_NO_AUTH=1

# Optional (defaults shown)
# RESUME_BUILDER_SESSION_MAX_AGE_DAYS=30
# RESUME_BUILDER_LOG_LEVEL=INFO
# RESUME_BUILDER_DB_PATH=/app/db/submissions.db
# RESUME_BUILDER_REPO_ROOT=/app

# Production (HTTPS only, e.g. Tailscale serve): set COOKIE_SECURE=1 or remove the line
# (default is 1) and remove SKIP_ORIGIN_CHECK (default strict origin).
